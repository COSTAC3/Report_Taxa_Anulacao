}
}
# Listar todas as folhas disponíveis no arquivo
sheet_names <- excel_sheets(input_file)
cat("Folhas disponíveis no ficheiro:\n", sheet_names)
# Ler os dados da folha "Page1_1"
data <- tryCatch({
read_excel(input_file, sheet = "Page1_1", col_names = FALSE)
}, error = function(e) {
stop("Erro ao ler os dados da folha 'Page1_1'. Detalhes do erro: ", e$message)
})
# Verificar se os dados foram carregados corretamente
if (is.null(data)) {
stop("Não foi possível carregar os dados da folha 'Page1_1'.")
}
# Função para preencher células vazias com o valor da célula acima
fill_empty_cells <- function(df) {
for (col in seq_len(ncol(df))) { # Para cada coluna
for (row in seq_len(nrow(df))) { # Para cada linha
if ((row > 1) && (is.na(df[row, col]) || df[row, col] == "")) { # Verificar se a célula está vazia
df[row, col] <- df[row - 1, col] # Preencher com o valor da célula acima
}
}
}
return(df)
}
# Aplicar a função para preencher células vazias
data <- fill_empty_cells(data)
# Remover as 6 primeiras linhas e as 2 últimas
if (nrow(data) > 8) {
data <- data[-c(1:6, (nrow(data)-1):nrow(data)), ]
} else {
stop("A tabela não contém linhas suficientes para remover as primeiras 6 e as últimas 2 linhas.")
}
# Remover a última coluna da tabela
data <- data[, -ncol(data)]
# Adicionar o cabeçalho especifica
colnames(data) <- c( "Data", "Produto", "Cliente", "Integralidade", "Canal Distribuição", "Tipo Agente",  "Apolices Emitidas", "Apolices Anuladas", "Apolices Vigentes")
#Algumas alterações
# 1º - Alterar as últimas 3 colunas para formato numérico com separador decimal como vírgula
data[, c("Apolices Emitidas", "Apolices Anuladas", "Apolices Vigentes")] <- lapply(data[, c("Apolices Emitidas", "Apolices Anuladas", "Apolices Vigentes")], function(col) {
as.numeric(as.character(col))
})
# 2º - Alterar os valores da coluna "Produto" para remover "1-" e manter apenas o nome
data$Produto <- gsub("^\\d+-", "", data$Produto)
data$`Canal Distribuição` <- gsub("^\\d+-", "", data$`Canal Distribuição`)
# 3º - Adicionar uma nova coluna "NUM_MES" depois da coluna "Data"
data$MES <- gsub("^\\d{4}/Jan$", "Janeiro",
gsub("^\\d{4}/Feb$", "Fevereiro",
gsub("^\\d{4}/Mar$", "Março",
gsub("^\\d{4}/Apr$", "Abril",
gsub("^\\d{4}/May$", "Maio",
gsub("^\\d{4}/Jun$", "Junho",
gsub("^\\d{4}/Jul$", "Julho",
gsub("^\\d{4}/Aug$", "Agosto",
gsub("^\\d{4}/Sep$", "Setembro",
gsub("^\\d{4}/Oct$", "Outubro",
gsub("^\\d{4}/Nov$", "Novembro",
gsub("^\\d{4}/Dec$", "Dezembro", data$Data))))))))))))
# 3º - Adicionar uma nova coluna "NUM_MES" depois da coluna "Data"
data$NUM_MES <- gsub("^\\d{4}/Jan$", 1,
gsub("^\\d{4}/Feb$", 2,
gsub("^\\d{4}/Mar$", 3,
gsub("^\\d{4}/Apr$", 4,
gsub("^\\d{4}/May$", 5,
gsub("^\\d{4}/Jun$", 6,
gsub("^\\d{4}/Jul$", 7,
gsub("^\\d{4}/Aug$", 8,
gsub("^\\d{4}/Sep$", 9,
gsub("^\\d{4}/Oct$", 10,
gsub("^\\d{4}/Nov$", 11,
gsub("^\\d{4}/Dec$", 12, data$Data))))))))))))
# 4º - Adicionar uma nova coluna "ANO" depois da coluna "Data"
data$ANO <- substr(data$Data, 1, 4)
# Reordenar as colunas
data <- data[, c( "ANO", "MES", "NUM_MES", "Produto", "Cliente", "Integralidade", "Canal Distribuição", "Tipo Agente",  "Apolices Emitidas", "Apolices Anuladas", "Apolices Vigentes")]
# Salvar o arquivo modificado
write_xlsx(data, output_file)
cat("O ficheiro foi modificado e guardado com sucesso em:", output_file, "\n")
library(readr)
library(dplyr)
library(writexl)
library(stringr)
library(readxl)
library(openxlsx)
# Diretórios
dir_path <- "//Nes000900-012/sftp_portugal/DRIVESMART"
dir_path_consolidado <- "//Nes000a10401/datascience_analytics/PROJETOS TRANSVERSAIS/Estratégia/Automóvel/WS_UBI_Portugal_Mobilize_MAPFRE/Drive Smart/Ficheiros_Ativações"
output_file <- file.path(dir_path_consolidado, "ActivationUsers_All.xlsx")
# Lista de ficheiros CSV
files <- list.files(
path = dir_path,
pattern = "(?i)^ActivationUsers_.*\\.csv$",
full.names = TRUE
)
message("Ficheiros encontrados: ", length(files))
# Ler consolidado existente (se houver)
if (file.exists(output_file)) {
existing_data <- read_excel(output_file)
existing_files <- unique(existing_data$source_file)
} else {
existing_data <- NULL
existing_files <- character(0)
}
# Filtrar ficheiros novos
new_files <- files[!basename(files) %in% existing_files]
# Se primeira execução, junta todos
if (length(existing_files) == 0) {
message("Primeira execução — vou juntar todos os ficheiros.")
new_files <- files
}
message("Ficheiros novos a ler: ", length(new_files))
print(basename(new_files))
# Ler ficheiros novos e consolidar
if (length(new_files) > 0) {
new_data <- lapply(new_files, function(f) {
df <- read_delim(f, delim = ";", show_col_types = FALSE, trim_ws = TRUE)
nome <- basename(f)
data_match <- str_extract(nome, "\\d{8}")
data_ficheiro <- if (!is.na(data_match)) as.Date(data_match, format = "%Y%m%d") else NA
df <- df %>%
mutate(source_file = nome, data_ficheiro = data_ficheiro)
return(df)
}) |> bind_rows()
combined_data <- bind_rows(existing_data, new_data)
writexl::write_xlsx(combined_data, output_file)
message("Consolidação concluída. Total de linhas: ", nrow(combined_data))
message("Ficheiro guardado em: ", output_file)
} else {
message("Nenhum ficheiro novo encontrado.")
combined_data <- existing_data  # Garantir que existe
}
# Criar ficheiros separados por "acuerdo"
if (!is.null(combined_data) && "acuerdo" %in% names(combined_data)) {
acordos <- unique(na.omit(combined_data$acuerdo))
message("A gerar ficheiros separados por acordo: ", paste(acordos, collapse = ","))
for (a in acordos) {
df_acuerdo <- combined_data %>% filter(acuerdo == a)
nome_saida <- paste0("ActivationUsers_", a, ".xlsx")
caminho_saida <- file.path(dir_path_consolidado, nome_saida)
writexl::write_xlsx(df_acuerdo, caminho_saida)
message("Gerado: ", nome_saida, " (", nrow(df_acuerdo), " linhas)")
}
} else {
message("Campo 'acuerdo' não encontrado - não foram criados ficheiros separados")
}
# Elegibilidade Final
activation_file <- file.path(dir_path_consolidado, "ActivationUsers_MFS.xlsx")
input_file <- file.path(dir_path_consolidado, "Suporte/Emissao_Nova.xlsx")
output_file_final <- file.path(dir_path_consolidado, "ActivationUsers_MFS_Final.xlsx")
activation_data <- read_excel(activation_file)
input_data <- read_excel(input_file)
merged_data <- activation_data %>%
mutate(`numero de poliza` = as.character(`numero de poliza`)) %>%
left_join(input_data %>% mutate(Apolice = as.character(Apolice)),
by = c("numero de poliza" = "Apolice")) %>%
mutate(
`fecha de alta en la aplicacion` = as.Date(`fecha de alta en la aplicacion`, format = "%d/%m/%Y"),
`Data efeito spto` = as.Date(`Data efeito spto`, format = "%d-%m-%Y"),
diferenca_dias = as.numeric(difftime(`fecha de alta en la aplicacion`, `Data efeito spto`, units = "days")),
elegivel = ifelse(diferenca_dias > 90, "Não", "Sim")
) %>%
select(
`Número de Apólice` = `numero de poliza`,
`Data Ativação APP` = `fecha de alta en la aplicacion`,
`Data Efeito Apólice` = `Data efeito spto`,
`Dif Dias Ativa-Efeito` = diferenca_dias,
`Elegivel Desconto Ativação` = elegivel
)
# Criar workbook formatado
wb <- createWorkbook()
addWorksheet(wb, "ActivationUsers_Final")
writeData(wb, "ActivationUsers_Final", merged_data)
# Estilo cabeçalho
header_style <- createStyle(fontColour = "white", fgFill = "red", textDecoration = "bold", halign = "center", border = "Bottom")
addStyle(wb, "ActivationUsers_Final", style = header_style, rows = 1, cols = 1:ncol(merged_data), gridExpand = TRUE)
# Ajustar largura
setColWidths(wb, "ActivationUsers_Final", cols = 1:ncol(merged_data), widths = "auto")
# Estilo elegível
eligible_style <- createStyle(fgFill = "lightgreen")
eligible_rows <- which(merged_data$`Elegivel Desconto Ativação` == "Sim") + 1
addStyle(wb, "ActivationUsers_Final", style = eligible_style, rows = eligible_rows, cols = which(names(merged_data) == "Elegivel Desconto Ativação"), gridExpand = TRUE)
# Estilo não elegível (Não)
not_eligible_style <- createStyle(fgFill = "#FF9999")  # vermelho claro
not_eligible_rows <- which(merged_data$`Elegivel Desconto Ativação` == "Não") + 1
addStyle(wb, "ActivationUsers_Final", style = not_eligible_style,
rows = not_eligible_rows,
cols = which(names(merged_data) == "Elegivel Desconto Ativação"),
gridExpand = TRUE)
# Estilo para datas dd/mm/yyyy
date_style <- createStyle(numFmt = "dd/mm/yyyy")
addStyle(wb, "ActivationUsers_Final", style = date_style,
rows = 2:(nrow(merged_data)+1),
cols = which(names(merged_data) %in% c("Data Ativação APP", "Data Efeito Apólice")),
gridExpand = TRUE)
# Esconder gridlines
showGridLines(wb, "ActivationUsers_Final", showGridLines = FALSE)
# Salvar
saveWorkbook(wb, output_file_final, overwrite = TRUE)
message("Arquivo final formatado criado com sucesso: ", output_file_final)
